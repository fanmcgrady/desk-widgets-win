<Window x:Class="DeskWidgets.StartupWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动项"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
  <Border Background="#F7FFFFFF" BorderBrush="#33000000" BorderThickness="1"
          CornerRadius="12" Padding="16,14" MinWidth="280" MaxWidth="420">
    <StackPanel>
      <TextBlock Text="启动项" FontSize="15" FontWeight="SemiBold" Foreground="#FF1C1B1F"/>
      <TextBlock x:Name="Hint" Margin="0,2,0,10" FontSize="12" Foreground="#FF605E5C"/>
      <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Rows"/>
      </ScrollViewer>
    </StackPanel>
  </Border>
</Window>
