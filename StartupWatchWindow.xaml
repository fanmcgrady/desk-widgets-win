<Window x:Class="DeskWidgets.StartupWatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#C0000000"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid Margin="72,56">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel LastChildFill="False">
      <TextBlock Text="BOOT" FontSize="32" FontWeight="Bold" Foreground="#FF00FF66"/>
      <TextBlock x:Name="Clock" DockPanel.Dock="Right" FontSize="32" Foreground="#FF00FF66"/>
    </DockPanel>

    <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="STARTUP" FontSize="13" Foreground="#FF1F8F45"/>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="64"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Rows"/>
      </ScrollViewer>
      <StackPanel Grid.Column="2" VerticalAlignment="Top">
        <TextBlock Text="STATUS" FontSize="12" Foreground="#FF1F8F45"/>
        <TextBlock x:Name="Hint" Margin="0,10,0,0" FontSize="48" FontWeight="Bold" Foreground="#FF00FF66"/>
        <TextBlock x:Name="HintSub" Margin="0,4,0,18" FontSize="14" Foreground="#FF8A8A8A"/>
        <Border x:Name="ProgressTrack" Height="3" Background="#3300FF66">
          <Border x:Name="ProgressFill" Height="3" HorizontalAlignment="Left" Background="#FF00FF66" Width="0"/>
        </Border>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="4" Margin="0,16,0,0" HorizontalAlignment="Right"
               Text="ESC" FontSize="12" Foreground="#FF1F8F45"/>
  </Grid>
</Window>
