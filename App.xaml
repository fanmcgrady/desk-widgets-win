<Application x:Class="DeskWidgets.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Teal"/>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="Bg" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="Panel" Color="#FFFFFFFF"/>
      <SolidColorBrush x:Key="Fg" Color="#FF1C1B1F"/>
      <SolidColorBrush x:Key="Muted" Color="#FF605E5C"/>
      <!-- 微软 Fluent 蓝 #0078D4 -->
      <SolidColorBrush x:Key="Accent" Color="#FF0078D4"/>
      <SolidColorBrush x:Key="AccentSoft" Color="#FFDEECF9"/>
      <SolidColorBrush x:Key="Line" Color="#1F000000"/>
      <SolidColorBrush x:Key="Hover" Color="#140078D4"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
