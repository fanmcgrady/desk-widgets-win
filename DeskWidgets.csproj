<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DeskWidgets</RootNamespace>
    <AssemblyName>DeskWidgets</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>DeskWidgets.Program</StartupObject>
    <!-- DesktopBox Shell 浏览器用到 64 位 COM -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- 子目录是独立工程，禁止主工程再扫一遍源码 -->
    <Compile Remove="DesktopBox\**" />
    <Page Remove="DesktopBox\**" />
    <ApplicationDefinition Remove="DesktopBox\**" />
    <None Remove="DesktopBox\**" />
    <EmbeddedResource Remove="DesktopBox\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="DesktopBox\DesktopBox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\agent-timeline.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="MaterialDesignColors" Version="5.4.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.79.2" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.79.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
