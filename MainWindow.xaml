<Window x:Class="DeskWidgets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="桌面侧栏"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FAFAFA"
        AllowsTransparency="False"
        FontFamily="Microsoft YaHei UI"
        FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
  <Window.Resources>
    <!-- 覆盖 MD 默认大按钮，侧栏内按钮默认透明文字 -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#14000000"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 邮件阅读区小操作按钮：不拉满整行 -->
    <Style x:Key="MailActionBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="56"/>
      <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MailGhostBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#14000000"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- 清掉 Material ScrollViewer 默认内边距，避免列表/空状态莫名缩进 -->
    <Style TargetType="ScrollViewer">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <!-- 侧栏输入框：去掉 MD 额外内边距，光标与 placeholder 左缘对齐 -->
    <Style x:Key="PlainInput" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="0" Padding="0"
                            VerticalAlignment="Center"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#FAFAFA" BorderBrush="#1A000000" BorderThickness="1,0,0,0">
    <DockPanel Margin="12,10,12,10">
      <!-- 顶栏标题 -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <materialDesign:PackIcon Kind="CalendarMonth" Width="20" Height="20"
                                   Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="方老师的桌面工作台" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource Fg}" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="BtnSync" DockPanel.Dock="Right" Click="BtnSync_Click"
                Padding="6,4" VerticalAlignment="Center" ToolTip="同步">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="Sync" Width="16" Height="16"
                                     Foreground="{StaticResource Muted}"
                                     VerticalAlignment="Center"/>
            <TextBlock Text="同步" FontSize="11.5" Margin="4,0,0,0"
                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </DockPanel>

      <!-- Tabs -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
        <Border x:Name="TabNoteBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                Margin="0,0,16,0" Cursor="Hand" Background="Transparent"
                MouseLeftButtonUp="TabNote_Click" Padding="0,0,0,6">
          <TextBlock x:Name="TabNoteText" Text="主题笔记" FontSize="13"/>
        </Border>
        <Border x:Name="TabTodoBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                Margin="0,0,16,0" Cursor="Hand" Background="Transparent"
                MouseLeftButtonUp="TabTodo_Click" Padding="0,0,0,6">
          <TextBlock x:Name="TabTodoText" Text="代办事项" FontSize="13" Foreground="{StaticResource Muted}"/>
        </Border>
        <Border x:Name="TabMailBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                Cursor="Hand" Background="Transparent"
                MouseLeftButtonUp="TabMail_Click" Padding="0,0,0,6">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TabMailText" Text="收发邮件" FontSize="13" Foreground="{StaticResource Muted}"/>
            <Border x:Name="MailTabBadge" Visibility="Collapsed" CornerRadius="8" Height="16"
                    MinWidth="16" Padding="5,0" Margin="6,0,0,0" Background="{StaticResource Accent}"
                    VerticalAlignment="Center">
              <TextBlock x:Name="MailTabBadgeText" Text="0" FontSize="10" Foreground="White"
                         FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 日历 -->
      <Border x:Name="CalendarHost" DockPanel.Dock="Top" Background="White" CornerRadius="8"
              Padding="8,8,8,6" Margin="0,0,0,10" BorderBrush="#10000000" BorderThickness="1">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="26" Margin="0,0,0,4">
            <Button Content="‹" FontSize="15" Width="26" Height="26"
                    HorizontalAlignment="Left" Click="PrevMonth_Click"
                    Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="MonthLabel" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="今天" FontSize="11" Foreground="{StaticResource Accent}"
                      Click="Today_Click" Padding="6,0" Height="26"/>
              <Button Content="›" FontSize="15" Width="26" Height="26"
                      Click="NextMonth_Click" Foreground="{StaticResource Muted}"/>
            </StackPanel>
          </Grid>
          <UniformGrid Rows="1" Columns="7" DockPanel.Dock="Top" Height="16" Margin="0,0,0,2">
            <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
          </UniformGrid>
          <UniformGrid x:Name="DayGrid" Columns="7"/>
        </DockPanel>
      </Border>

      <Grid>
        <!-- 代办 -->
        <DockPanel x:Name="TodoPanel" Visibility="Collapsed">
          <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="8" Padding="8"
                  BorderBrush="#10000000" BorderThickness="1" Margin="0,8,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="添加" Style="{StaticResource PrimaryBtn}"
                      Margin="8,0,0,0" Click="BtnAddTodo_Click"/>
              <Grid>
                <TextBox x:Name="TodoInput" Style="{StaticResource PlainInput}"
                         Height="30" Padding="0"
                         KeyDown="TodoInput_KeyDown" TextChanged="TodoInput_TextChanged"
                         GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                <TextBlock x:Name="TodoPlaceholder" IsHitTestVisible="False"
                           Text="新任务，回车添加" Foreground="{StaticResource Muted}"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="0" Padding="0"/>
              </Grid>
            </DockPanel>
          </Border>
          <TextBlock x:Name="SyncHint" Visibility="Collapsed"/>
          <TextBlock x:Name="DueHint" Visibility="Collapsed"/>

          <Grid DockPanel.Dock="Top" Margin="2,0,2,8" MinHeight="22">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="TodoSectionTitle" Text="今日待办"
                         FontWeight="SemiBold" FontSize="12.5"
                         VerticalAlignment="Center" Cursor="Hand"
                         MouseLeftButtonUp="TodoSectionTitle_Click"
                         ToolTip="点击查看全部待办"/>
              <TextBlock x:Name="TodoProgress" Margin="8,0,0,0"
                         Foreground="{StaticResource Muted}" FontSize="11.5"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="ShowDoneHit" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonUp="ShowDoneHit_Click">
              <Border x:Name="ShowDoneBox" Width="14" Height="14" CornerRadius="3"
                      BorderThickness="1.2" BorderBrush="{StaticResource Muted}"
                      Background="Transparent" VerticalAlignment="Center"/>
              <TextBlock Text="显示已完成" FontSize="11.5" Margin="6,0,0,0"
                         Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="ShowDoneCheck" Visibility="Collapsed"
                      Checked="ShowDone_Changed" Unchecked="ShowDone_Changed"/>
          </Grid>

          <Border Background="White" CornerRadius="8" BorderBrush="#10000000" BorderThickness="1"
                  Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0" Margin="0"
                          CanContentScroll="False">
              <StackPanel x:Name="TodoList" Margin="0"/>
            </ScrollViewer>
          </Border>
        </DockPanel>

        <!-- 笔记 -->
        <DockPanel x:Name="NotePanel">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Height="24">
            <Button Content="+ 新建" Foreground="{StaticResource Accent}" FontSize="12"
                    Click="BtnNewNote_Click"/>
            <Button x:Name="BtnAddTodoFromNote" Content="加入代办"
                    HorizontalAlignment="Right"
                    Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"
                    Click="BtnAddTodoFromNote_Click"/>
          </DockPanel>
          <ScrollViewer x:Name="NoteListHost" DockPanel.Dock="Top" Height="26"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        Margin="0,0,0,6">
            <StackPanel x:Name="NoteList" Orientation="Horizontal"/>
          </ScrollViewer>
          <Button x:Name="BtnNotepad" DockPanel.Dock="Bottom"
                  Content="用记事本打开" Style="{StaticResource PrimaryBtn}"
                  Height="34" Margin="0,8,0,0" FontSize="13"
                  Click="BtnNotepad_Click"/>
          <Border Background="White" CornerRadius="8" Padding="10,8"
                  BorderBrush="#10000000" BorderThickness="1">
            <TextBox x:Name="NoteEdit"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"
                     FontSize="13" Padding="0"
                     GotKeyboardFocus="Input_GotFocus"
                     LostKeyboardFocus="Input_LostFocus"
                     TextChanged="NoteEdit_TextChanged"/>
          </Border>
        </DockPanel>

        <DockPanel x:Name="MailPanel" Visibility="Collapsed">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="MailTabInbox" BorderThickness="0,0,0,2" BorderBrush="{StaticResource Accent}"
                      Margin="0,0,14,0" Cursor="Hand" Padding="0,0,0,4"
                      MouseLeftButtonUp="MailTabInbox_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="MailTabInboxText" Text="收件箱" FontSize="12.5" FontWeight="SemiBold"/>
                  <Border x:Name="MailInboxBadge" Visibility="Collapsed" CornerRadius="8" Height="15"
                          MinWidth="15" Padding="4,0" Margin="5,0,0,0" Background="{StaticResource Accent}"
                          VerticalAlignment="Center">
                    <TextBlock x:Name="MailInboxBadgeText" Text="0" FontSize="9.5" Foreground="White"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
              </Border>
              <Border x:Name="MailTabCompose" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                      Margin="0,0,14,0" Cursor="Hand" Padding="0,0,0,4"
                      MouseLeftButtonUp="MailTabCompose_Click">
                <TextBlock x:Name="MailTabComposeText" Text="写邮件" FontSize="12.5"
                           Foreground="{StaticResource Muted}"/>
              </Border>
              <Border x:Name="MailTabSettings" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                      Cursor="Hand" Padding="0,0,0,4"
                      MouseLeftButtonUp="MailTabSettings_Click">
                <TextBlock x:Name="MailTabSettingsText" Text="设置" FontSize="12.5"
                           Foreground="{StaticResource Muted}"/>
              </Border>
            </StackPanel>
            <Button x:Name="BtnMailRefresh" DockPanel.Dock="Right" Content="刷新"
                    Foreground="{StaticResource Muted}" FontSize="11.5"
                    Click="BtnMailRefresh_Click" VerticalAlignment="Center"/>
          </DockPanel>

          <TextBlock x:Name="MailStatus" DockPanel.Dock="Top" FontSize="11"
                     Foreground="{StaticResource Muted}" Margin="2,0,2,6" TextWrapping="Wrap"
                     Visibility="Collapsed"/>

          <!-- 四个视图叠在同一铺满区域，避免 DockPanel 默认左停靠把写信挤成窄条 -->
          <Grid>
            <!-- 收件箱 -->
            <Border x:Name="MailListHost" Background="White" CornerRadius="8"
                    BorderBrush="#10000000" BorderThickness="1" Padding="0">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel x:Name="MailList"/>
              </ScrollViewer>
            </Border>

            <!-- 阅读 -->
            <DockPanel x:Name="MailReadHost" Visibility="Collapsed">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                <Button Content="← 返回" Style="{StaticResource MailGhostBtn}"
                        Click="BtnMailBack_Click" HorizontalAlignment="Left"/>
                <Button DockPanel.Dock="Right" Content="回复" Style="{StaticResource MailActionBtn}"
                        Click="BtnMailReply_Click"/>
              </DockPanel>
              <Border Background="White" CornerRadius="8" BorderBrush="#10000000" BorderThickness="1"
                      Padding="16,14">
                <!-- Disabled 横向：否则子级按无限宽测量，正文不换行、附件星列变 0，右侧被裁切 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock x:Name="MailReadSubject" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,0,8"/>
                    <TextBlock x:Name="MailReadMeta" FontSize="12"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               VerticalAlignment="Top" Margin="0,0,0,10"/>
                    <StackPanel x:Name="MailReadAttachments" Margin="0,0,0,12"/>
                    <TextBlock x:Name="MailReadBody" FontSize="13.5" TextWrapping="Wrap"
                               VerticalAlignment="Top" TextOptions.TextFormattingMode="Display"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </DockPanel>

            <!-- 写信：整页铺满 -->
            <DockPanel x:Name="MailComposeHost" Visibility="Collapsed">
              <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="Ctrl+Enter 发送" Foreground="{StaticResource Muted}" FontSize="11"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="发送" Style="{StaticResource PrimaryBtn}"
                        Width="88" Height="32" Click="BtnMailSend_Click"/>
              </DockPanel>
              <Border Background="White" CornerRadius="8" BorderBrush="#10000000" BorderThickness="1"
                      Padding="12,10">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,2" MinHeight="30">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="收件" Foreground="{StaticResource Muted}" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <Grid Grid.Column="1">
                        <TextBox x:Name="MailTo" Style="{StaticResource PlainInput}"
                                 FontSize="12.5" MinHeight="28" VerticalContentAlignment="Center"
                                 TextChanged="MailComposeField_TextChanged"
                                 GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                        <TextBlock x:Name="MailToHint" Text="收件人邮箱，多人用分号分隔"
                                   IsHitTestVisible="False" Foreground="#AA79747E" FontSize="12"
                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                      </Grid>
                    </Grid>
                    <Border Height="1" Background="#12000000" Margin="0,4,0,4"/>
                    <Grid Margin="0,0,0,2" MinHeight="30">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="主题" Foreground="{StaticResource Muted}" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <Grid Grid.Column="1">
                        <TextBox x:Name="MailSubject" Style="{StaticResource PlainInput}"
                                 FontSize="12.5" MinHeight="28" VerticalContentAlignment="Center"
                                 TextChanged="MailComposeField_TextChanged"
                                 GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                        <TextBlock x:Name="MailSubjectHint" Text="邮件主题"
                                   IsHitTestVisible="False" Foreground="#AA79747E" FontSize="12"
                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                      </Grid>
                    </Grid>
                    <Border Height="1" Background="#12000000" Margin="0,4,0,8"/>
                  </StackPanel>
                  <Grid>
                    <TextBox x:Name="MailBody" Style="{StaticResource PlainInput}"
                             AcceptsReturn="True" TextWrapping="Wrap" FontSize="12.5"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="MailComposeField_TextChanged"
                             PreviewKeyDown="MailBody_PreviewKeyDown"
                             GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                    <TextBlock x:Name="MailBodyHint" Text="正文…"
                               IsHitTestVisible="False" Foreground="#AA79747E" FontSize="12.5"
                               Margin="2,4,0,0" VerticalAlignment="Top"/>
                  </Grid>
                </DockPanel>
              </Border>
            </DockPanel>

            <!-- 设置 -->
            <Border x:Name="MailSettingsHost" Visibility="Collapsed" Background="White"
                    CornerRadius="8" BorderBrush="#10000000" BorderThickness="1" Padding="12,10">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="川大邮箱 / IMAP·SMTP" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                  <TextBlock Text="密码仅保存在本机（Windows DPAPI）" Foreground="{StaticResource Muted}"
                             FontSize="11" Margin="0,0,0,10"/>
                  <TextBlock Text="邮箱" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,2"/>
                  <Border Background="#08000000" CornerRadius="6" Padding="8,0" Margin="0,0,0,8">
                    <TextBox x:Name="MailCfgEmail" Style="{StaticResource PlainInput}" Height="30" FontSize="12.5"
                             GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                  </Border>
                  <TextBlock Text="密码" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,2"/>
                  <Border Background="#08000000" CornerRadius="6" Padding="8,0" Margin="0,0,0,8">
                    <PasswordBox x:Name="MailCfgPassword" Height="30" FontSize="12.5"
                                 Padding="0,4" BorderThickness="0" Background="Transparent"
                                 GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                  </Border>
                  <TextBlock Text="显示名（可选）" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,2"/>
                  <Border Background="#08000000" CornerRadius="6" Padding="8,0" Margin="0,0,0,8">
                    <TextBox x:Name="MailCfgDisplayName" Style="{StaticResource PlainInput}" Height="30" FontSize="12.5"
                             GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                  </Border>
                  <TextBlock Text="IMAP" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,2"/>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#08000000" CornerRadius="6" Padding="8,0" Margin="0,0,6,0">
                      <TextBox x:Name="MailCfgImapHost" Style="{StaticResource PlainInput}" Height="30" FontSize="12.5"
                               GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                    </Border>
                    <Border Grid.Column="1" Background="#08000000" CornerRadius="6" Padding="8,0">
                      <TextBox x:Name="MailCfgImapPort" Style="{StaticResource PlainInput}" Height="30"
                               FontSize="12.5" TextAlignment="Center"
                               GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                    </Border>
                  </Grid>
                  <TextBlock Text="SMTP" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,2"/>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#08000000" CornerRadius="6" Padding="8,0" Margin="0,0,6,0">
                      <TextBox x:Name="MailCfgSmtpHost" Style="{StaticResource PlainInput}" Height="30" FontSize="12.5"
                               GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                    </Border>
                    <Border Grid.Column="1" Background="#08000000" CornerRadius="6" Padding="8,0">
                      <TextBox x:Name="MailCfgSmtpPort" Style="{StaticResource PlainInput}" Height="30"
                               FontSize="12.5" TextAlignment="Center"
                               GotKeyboardFocus="Input_GotFocus" LostKeyboardFocus="Input_LostFocus"/>
                    </Border>
                  </Grid>
                  <Button Content="保存并测试连接" Style="{StaticResource PrimaryBtn}" Height="32"
                          Click="BtnMailSaveSettings_Click"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </DockPanel>
      </Grid>
    </DockPanel>
  </Border>
</Window>
