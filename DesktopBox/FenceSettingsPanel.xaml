<UserControl x:Class="DesktopBox.FenceSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="White" CornerRadius="8" BorderBrush="#10000000" BorderThickness="1" Padding="8,6">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
        <TextBlock Text="桌面分区" FontWeight="SemiBold" FontSize="12"
                   VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnOpenConfig" Content="配置" Height="22" Margin="0,0,4,0" Padding="6,0"
                  Background="Transparent" BorderThickness="0" Foreground="#FF0078D4"
                  Cursor="Hand" FontSize="11" Click="BtnOpenConfig_Click"
                  ToolTip="打开配置文件"/>
          <Button x:Name="BtnRefresh" Content="刷新" Height="22" Padding="6,0"
                  Background="Transparent" BorderThickness="0" Foreground="#FF605E5C"
                  Cursor="Hand" FontSize="11" Click="BtnRefresh_Click"
                  ToolTip="刷新围栏"/>
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" FontSize="10.5"
                 Foreground="#FF605E5C" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                 Margin="0,4,0,0" Text="随工作区一起启动"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0" Margin="0">
        <StackPanel x:Name="Body">
          <WrapPanel Margin="0,0,0,4">
            <CheckBox x:Name="ChkAutoSort" Content="新文件归入内存" FontSize="11"
                      Margin="0,0,12,4" VerticalAlignment="Center"
                      Checked="ChkAutoSort_Changed" Unchecked="ChkAutoSort_Changed"/>
            <CheckBox x:Name="ChkShowFences" Content="显示围栏" FontSize="11"
                      Margin="0,0,12,4" VerticalAlignment="Center" IsChecked="True"
                      Checked="ChkShowFences_Changed" Unchecked="ChkShowFences_Changed"/>
          </WrapPanel>
          <DockPanel Margin="0,0,0,6" LastChildFill="False">
            <TextBlock Text="区间拖放" FontSize="10.5" Foreground="#FF605E5C"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       ToolTip="在各个分区之间拖动文件时的默认行为"/>
            <RadioButton x:Name="RadioMove" Content="移动" GroupName="DropMode" FontSize="11"
                         Margin="0,0,10,0" VerticalAlignment="Center" IsChecked="True"
                         ToolTip="拖到另一分区时移动文件"/>
            <RadioButton x:Name="RadioCopy" Content="复制" GroupName="DropMode" FontSize="11"
                         VerticalAlignment="Center"
                         ToolTip="拖到另一分区时复制文件"/>
          </DockPanel>

          <TextBlock Text="分区路径" FontSize="10.5" Foreground="#FF605E5C" Margin="0,0,0,2"/>
          <StackPanel x:Name="ZoneList"/>

          <Button x:Name="BtnSave" Content="保存并重载" Height="28" Margin="0,6,0,0"
                  Background="#FF0078D4" Foreground="White" BorderThickness="0"
                  Cursor="Hand" Click="BtnSave_Click"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
