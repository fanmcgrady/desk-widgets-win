<Window x:Class="DesktopBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopBox"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="White"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="False"
        ShowActivated="False">
  <!--
    不能开 AllowsTransparency：否则 HwndHost 无法显示。
    白槽点穿与异形裁剪交给 SetWindowRgn；底板用白，避免灰框感。
  -->
  <Grid x:Name="RootGrid" Background="White" />
</Window>
