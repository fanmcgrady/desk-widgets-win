<Window x:Class="DesktopBox.StatsAppBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskStats"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False"
        Background="#FFF7F7F7"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
  <Border BorderBrush="#14000000" BorderThickness="0,1,0,0" Background="#FFF7F7F7"
          Padding="10,2" ClipToBounds="True">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                  HorizontalAlignment="Left" Margin="0,0,12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="Cursor" FontSize="9" Foreground="#FF999999"
                     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="StatsCursor" Text="—" FontSize="11" FontWeight="SemiBold"
                     Foreground="#FF333333" VerticalAlignment="Center" MinWidth="36"
                     TextAlignment="Left"/>
          <TextBlock x:Name="StatsCursorHint" Text="" FontSize="9"
                     Foreground="#FFAAAAAA" Margin="4,0,0,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     MinWidth="56" MaxWidth="88"/>
          <Border x:Name="StatsCursorTrack" Height="2" Background="#14000000"
                  CornerRadius="1" Margin="5,0,0,0" Width="40" VerticalAlignment="Center">
            <Border x:Name="StatsCursorBar" Height="2" HorizontalAlignment="Left"
                    Background="#FF0078D4" CornerRadius="1" Width="0"/>
          </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="开机" FontSize="9" Foreground="#FF999999"
                     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="StatsUptime" Text="—" FontSize="11" FontWeight="SemiBold"
                     Foreground="#FF333333" VerticalAlignment="Center"
                     TextAlignment="Left"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Wi‑Fi" FontSize="9" Foreground="#FF999999"
                     VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock x:Name="StatsWifi" Text="—" FontSize="11" FontWeight="SemiBold"
                     Foreground="#FF333333" VerticalAlignment="Center" Width="22"
                     TextAlignment="Left"/>
          <TextBlock x:Name="StatsWifiSsid" FontSize="9" Foreground="#FF888888"
                     Margin="4,0,0,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Width="64"/>
          <Border x:Name="StatsWifiTrack" Height="2" Background="#14000000"
                  CornerRadius="1" Margin="5,0,0,0" Width="32" VerticalAlignment="Center">
            <Border x:Name="StatsWifiBar" Height="2" HorizontalAlignment="Left"
                    Background="#FF107C10" CornerRadius="1" Width="0"/>
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- 外层裁剪，绿底/滑动都不得画出列边界 -->
      <Border Grid.Column="1" ClipToBounds="True" VerticalAlignment="Stretch">
        <Border x:Name="NoticePanel" Background="Transparent"
                CornerRadius="3" Padding="6,0" MaxHeight="22"
                VerticalAlignment="Center" HorizontalAlignment="Stretch">
          <DockPanel x:Name="NoticeContent" LastChildFill="True" VerticalAlignment="Center">
            <DockPanel.RenderTransform>
              <TranslateTransform x:Name="NoticeSlide" X="0"/>
            </DockPanel.RenderTransform>
            <Border x:Name="NoticeBadge" DockPanel.Dock="Left"
                    Background="#FF107C10" CornerRadius="3" Padding="7,0" Margin="0,0,8,0"
                    Visibility="Collapsed" VerticalAlignment="Center" Height="18">
              <TextBlock x:Name="NoticeBadgeText" Text="已复制" FontSize="10" FontWeight="Bold"
                         Foreground="White" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="NoticeText" Text="" FontSize="11" FontWeight="SemiBold"
                       Foreground="#FF1B5E20" VerticalAlignment="Center"
                       TextAlignment="Left"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          </DockPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
