<UserControl x:Class="DesktopBox.ZoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown">
  <!-- 直角细边：细线圆角在 DPI 下易发虚，统一直角更干净 -->
  <Border x:Name="Frame"
          CornerRadius="0"
          BorderThickness="1"
          BorderBrush="#40B0B0B0"
          Background="White"
          ClipToBounds="True"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition x:Name="StatsRow" Height="0" />
      </Grid.RowDefinitions>

      <Border x:Name="TitleBar"
              Grid.Row="0"
              Background="White"
              BorderBrush="#14000000"
              BorderThickness="0,0,0,1"
              Padding="8,3,8,2"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock x:Name="TitleText"
                   FontSize="13"
                   FontWeight="Normal"
                   FontFamily="Microsoft YaHei"
                   Foreground="#FF5C5C5C"
                   TextAlignment="Left"
                   TextTrimming="CharacterEllipsis" />
      </Border>

      <Grid x:Name="ShellHostContainer"
            Grid.Row="1"
            Margin="0" />

      <!-- 内存区底部：白底系统状态条 -->
      <Border x:Name="StatsPanel"
              Grid.Row="2"
              Visibility="Collapsed"
              Background="#FFF7F7F7"
              BorderBrush="#14000000"
              BorderThickness="0,1,0,0"
              Padding="10,8"
              IsHitTestVisible="False">
        <UniformGrid Columns="4" Rows="1">
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="CPU" FontSize="10" Foreground="#FF999999"/>
            <TextBlock x:Name="StatsCpu" Text="—" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF333333" Margin="0,2,0,0"/>
            <Border Height="3" Background="#14000000" CornerRadius="1" Margin="0,6,8,0">
              <Border x:Name="StatsCpuBar" Height="3" HorizontalAlignment="Left"
                      Background="#FF0078D4" CornerRadius="1" Width="0"/>
            </Border>
          </StackPanel>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="内存" FontSize="10" Foreground="#FF999999"/>
            <TextBlock x:Name="StatsMem" Text="—" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF333333" Margin="0,2,0,0"/>
            <TextBlock x:Name="StatsMemDetail" Text="" FontSize="10"
                       Foreground="#FFAAAAAA" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Text="网络" FontSize="10" Foreground="#FF999999"/>
            <TextBlock x:Name="StatsNetDown" Text="↓ —" FontSize="12"
                       Foreground="#FF333333" Margin="0,2,0,0"/>
            <TextBlock x:Name="StatsNetUp" Text="↑ —" FontSize="12"
                       Foreground="#FF333333" Margin="0,1,0,0"/>
          </StackPanel>
          <StackPanel>
            <DockPanel LastChildFill="True">
              <TextBlock Text="Wi‑Fi" FontSize="10" Foreground="#FF999999"
                         VerticalAlignment="Center"/>
              <TextBlock x:Name="StatsWifiSsid" FontSize="10" Foreground="#FF888888"
                         Margin="6,0,0,0" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock x:Name="StatsWifi" Text="—" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF333333" Margin="0,2,0,0"/>
            <Border x:Name="StatsWifiTrack" Height="4" Background="#14000000"
                    CornerRadius="2" Margin="0,6,0,0">
              <Border x:Name="StatsWifiBar" Height="4" HorizontalAlignment="Left"
                      Background="#FF107C10" CornerRadius="2" Width="0"/>
            </Border>
          </StackPanel>
        </UniformGrid>
      </Border>
    </Grid>
  </Border>
</UserControl>
